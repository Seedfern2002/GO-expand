{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "task"
          ]
        },
        "gene_universe_path": {
          "type": "string"
        },
        "gene_field": {
          "type": "string"
        }
      },
      "required": [
        "unit",
        "gene_universe_path",
        "gene_field"
      ],
      "additionalProperties": false
    },
    "task_interpretation": {
      "type": "string"
    },
    "augmentations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "biological_rationale": {
            "type": "string"
          },
          "ingestion_mode": {
            "type": "string",
            "enum": [
              "bulk_table",
              "structured_query",
              "focused_literature"
            ]
          },
          "source_preferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bulk_resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mapping_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projection_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "category",
          "priority",
          "biological_rationale",
          "ingestion_mode",
          "source_preferences",
          "bulk_resources",
          "mapping_rules",
          "context_rules",
          "quality_rules",
          "projection_rules",
          "retrieval_queries"
        ],
        "additionalProperties": false
      }
    },
    "audit_policy": {
      "type": "object",
      "properties": {
        "sample_seed": {
          "type": "integer",
          "minimum": 0
        },
        "sample_records_per_batch": {
          "type": "integer",
          "minimum": 0
        },
        "exception_routing": {
          "type": "string"
        }
      },
      "required": [
        "sample_seed",
        "sample_records_per_batch",
        "exception_routing"
      ],
      "additionalProperties": false
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "scope",
    "task_interpretation",
    "augmentations",
    "audit_policy",
    "stop_conditions",
    "human_questions"
  ],
  "additionalProperties": false
}
